{
  "name": "opencode-search1api",
  "version": "0.1.1",
  "description": "Search1API web search, agentic search, news, page retrieval, sitemap, and trending tools for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superagents-lab/opencode-search1api.git"
  },
  "homepage": "https://s1.dev/docs",
  "bugs": {
    "url": "https://github.com/superagents-lab/opencode-search1api/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "search1api",
    "web-search",
    "news",
    "crawl"
  ],
  "exports": {
